{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Umbra",
  "version": "0.1.0",
  "identifier": "dev.umbra.launcher",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Umbra",
        "width": 1050,
        "height": 640,
        "resizable": false,
        "decorations": false,
        "center": true,
        "backgroundColor": "#030308"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
